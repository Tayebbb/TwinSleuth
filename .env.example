# 0 = OpenAI for the main demo; 1 = FreeLLMPool for testing only
TWINSLEUTH_TESTING_MODE=0

# Production learner-facing AI provider (used only when testing mode is 0)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Local free pool (used only when testing mode is 1)
FREELLMPOOL_BASE_URL=http://127.0.0.1:8080/v1
FREELLMPOOL_API_KEY=unused
FREELLMPOOL_MODEL=auto

# Hosted durable storage (required on Vercel; local runs default to SQLite)
DATABASE_URL=
